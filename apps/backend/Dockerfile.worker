FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src
COPY apps/backend/ ./
RUN dotnet restore ProofPath.slnx && dotnet publish src/ProofPath.Worker/ProofPath.Worker.csproj -c Release -o /app --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0-alpine AS final
WORKDIR /app
ENV DOTNET_EnableDiagnostics=0
COPY --from=build /app .
USER $APP_UID
ENTRYPOINT ["dotnet", "ProofPath.Worker.dll"]
